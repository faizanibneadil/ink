{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Only used for the Cloudflare deployment (CI/CD). Local `pnpm dev` never reads this file.
  // The `__PLACEHOLDER__` values are filled in by `scripts/prepare-cloudflare.mjs` from GitHub secrets/variables.
  "name": "__WORKER_NAME__",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Enable Node.js APIs (also populates `process.env` from vars & secrets)
    "nodejs_compat",
    // Allow to fetch URLs in your app
    "global_fetch_strictly_public",
  ],
  // `*.workers.dev` URL + preview URLs (https://developers.cloudflare.com/workers/previews/)
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "__D1_DATABASE_ID__",
      "database_name": "__D1_DATABASE_NAME__",
      // Lets the Payload CLI (`payload migrate`) reach the real D1 database from CI.
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "__R2_BUCKET_NAME__",
    },
  ],
}
