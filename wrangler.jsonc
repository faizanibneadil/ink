{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Only used for the Cloudflare deployment (CI/CD). Local `pnpm dev` never reads this file.
  "name": "ink",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Enable Node.js APIs (also populates `process.env` from vars & secrets)
    "nodejs_compat",
    // Allow to fetch URLs in your app
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // `*.workers.dev` URL + preview URLs (https://developers.cloudflare.com/workers/previews/)
  "workers_dev": true,
  "preview_urls": true,
  // Custom domain: Cloudflare creates the DNS record + certificate on deploy.
  // Requires the `devslix.com` zone to be in the same Cloudflare account.
  "routes": [
    {
      "pattern": "ink.devslix.com",
      "custom_domain": true,
    },
  ],
  // Workers Logs, traces and Issues (https://developers.cloudflare.com/workers/observability/).
  // Every request is logged and traced (sampling rate 1) and kept in the Cloudflare dashboard.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "vars": {
    // Payload `serverURL` and the only allowed CORS / CSRF origin in production.
    // Previews get their own Preview URL from CI (`wrangler preview --var SERVER_URL:...`).
    "SERVER_URL": "https://ink.devslix.com",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "aea2b56e-09bf-4b16-b157-acaed317f04a",
      "database_name": "ink",
      // Lets the Payload CLI (`payload migrate`) reach the real D1 database from CI.
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ink",
    },
  ],
  // Worker Previews (https://developers.cloudflare.com/workers/previews/), created by CI for every
  // branch with `wrangler preview`. Previews do not inherit the production bindings above: they use
  // the separate `ink-preview` D1 database and R2 bucket, shared by all Previews.
  // Keep the D1 binding in sync with `wrangler.preview-migrations.jsonc`.
  "previews": {
    "d1_databases": [
      {
        "binding": "D1",
        "database_id": "93dbd054-16cf-417d-b59a-b8ca4e2085cc",
        "database_name": "ink-preview",
      },
    ],
    "r2_buckets": [
      {
        "binding": "R2",
        "bucket_name": "ink-preview",
      },
    ],
  },
}
